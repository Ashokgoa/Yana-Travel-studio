# Copy to `.env` and adjust. All backend variables use the YANA_ prefix.
# Relative paths resolve against the project root.

YANA_ENVIRONMENT=development
YANA_DEBUG=false

# Signs login sessions. scripts/setup.ps1 generates a random value in .env.
# Never commit a real key. Changing it signs everybody out.
YANA_SECRET_KEY=

# Session length in minutes (default 720 = 12 hours)
# YANA_ACCESS_TOKEN_MINUTES=720

# SQLite by default. For PostgreSQL later, e.g.:
# YANA_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/yana
# YANA_DATABASE_URL=sqlite:///C:/path/to/yana_studio.db

YANA_UPLOADS_DIR=uploads
YANA_EXPORTS_DIR=exports
YANA_BACKUPS_DIR=database/backups
YANA_MAX_UPLOAD_MB=10

# JSON list of allowed browser origins for the API
YANA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (frontend/.env.local), server-side only; browsers always use /api/v1
# BACKEND_URL=http://127.0.0.1:8000
